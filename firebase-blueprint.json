{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in Carizma system",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Reservation": {
      "title": "Reservation",
      "description": "Booking or walk-in reservation record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "guest_name": { "type": "string" },
        "guest_phone": { "type": "string" },
        "branch": { "type": "string" },
        "room_type_id": { "type": "string" },
        "check_in_date": { "type": "string" },
        "check_in_time": { "type": "string" },
        "number_of_guests": { "type": "number" },
        "status": { "type": "string" },
        "source": { "type": "string" },
        "createdAt": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["guest_name", "branch", "check_in_date", "status"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Room, table, hall, or apartment unit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "branch": { "type": "string" },
        "name": { "type": "string" },
        "room_number_or_label": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "capacity": { "type": "number" },
        "price_ngn": { "type": "number" }
      },
      "required": ["id", "branch", "name", "category", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/reservations/{reservationId}": {
      "schema": { "$ref": "#/entities/Reservation" },
      "description": "Front desk booking reservations"
    },
    "/inventory/{itemId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Hotel and branch room inventory items"
    }
  }
}
